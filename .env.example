# --- LLM (leave the key empty to use demo sidecar extractions from ./data/sidecars) ---
ANTHROPIC_API_KEY=
MODEL_PRIMARY=claude-haiku-5-5
MODEL_FALLBACK=claude-sonnet-5-5
LLM_RPM=500
LLM_TPM=400000

# --- Storage ---
DATABASE_URL=sqlite:///./data/invoice_guard.db
# DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoice_guard
OBJECT_STORE_DIR=./data/blobs

# --- Messaging ---
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_IN=invoices.received
KAFKA_TOPIC_POSTED=invoices.posted
KAFKA_TOPIC_DLQ=invoices.dlq

# --- API ---
DEV_AUTH=true            # trusts X-User header; NEVER in production (use OIDC)
CORS_ORIGINS=http://localhost:3000

# Business thresholds are versioned per legal entity in libs/rules/config.py
