# --- LLM ---
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5        # default extraction tier (check current model IDs)
MODEL_STRONG=claude-sonnet-4-5     # escalation tier
LLM_MAX_OUTPUT_TOKENS=1200
MIN_FIELD_CONFIDENCE=0.85

# --- Storage ---
DATABASE_URL=sqlite:///./data/invoice_guard.db
# DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoice_guard
CHECKPOINT_URL=./data/checkpoints.db
OBJECT_STORE_DIR=./data/blobs

# --- Messaging ---
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_IN=invoices.received
KAFKA_TOPIC_POSTED=invoices.posted
KAFKA_TOPIC_DLQ=invoices.dlq
REDIS_URL=redis://localhost:6379/0

# --- Business rules ---
DATE_MAX_AGE_DAYS=90
PRICE_TOLERANCE=0.02
TOTAL_TOLERANCE_MINOR=1
MAKER_CHECKER_THRESHOLD_LKR=1000000

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
